# Copy to .env.local (never commit .env.local).

# true = fake data in your browser (default, no accounts needed). false = real Supabase.
NEXT_PUBLIC_USE_MOCK=true

# Browser-safe Supabase values (Project Settings -> API). Person C shares these in team chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Only Person C and Vercel need it.
ANTHROPIC_API_KEY=
