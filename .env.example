# Copy to .env.local (never commit .env.local).

# true = fake data in your browser (default, no accounts needed). false = real Supabase.
NEXT_PUBLIC_USE_MOCK=true

# Browser-safe Supabase values (Project Settings -> API). Needed only when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Google Gemini key for Explain Now and the study guide (https://aistudio.google.com/apikey).
# Never prefix with NEXT_PUBLIC_. Read only by the server routes in src/app/api/.
GEMINI_API_KEY=
# Optional: a different Gemini model (default gemini-3.8-flash).
GEMINI_MODEL=
